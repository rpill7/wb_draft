# Send only what the app needs. Everything else (including .env, .venv, tests, plans,
# outputs/runs, .cache, and the instructions document) stays out of the image.
*
!pyproject.toml
!uv.lock
!.python-version
!src/
!data/raw/
# Theme file only. .streamlit/secrets.toml stays out of the image.
!.streamlit/
.streamlit/*
!.streamlit/config.toml
**/__pycache__
**/*.pyc
